# Plantilla de configuración del módulo IHCE/RDA (Resolución 1888 de 2025).
#
# Uso: copiar a un archivo fuera del control de versiones y compilar con
#   flutter build web --dart-define-from-file=<archivo>
#
# TODO lo que se compila en la PWA es público. Este archivo NO lleva ni
# llevará nunca secretos: el ClientID, el ClientSecret y la clave de
# suscripción del API se escriben en la pantalla del profesional
# («ClientID de MinSalud», «ClientSecret de MinSalud») y viven solo en
# flutter_secure_storage del equipo. No existen variables IHCE_CLIENT_ID,
# IHCE_CLIENT_SECRET ni IHCE_SUBSCRIPTION_KEY, a propósito.
#
# Valores vacíos = valor por defecto (ver lib/core/ihce/config/config_ihce.dart
# y docs/ihce/README.md). Los marcados TODO(IHCE-VERIFICAR) los entrega
# MinSalud con las credenciales.

# Bandera del módulo. Apagado: comportamiento clínico idéntico al de antes.
IHCE_ENABLED=false

# Ambiente: preproduccion (por defecto) | produccion (las credenciales se
# guardan por ambiente).
IHCE_ENV=

# TODO(IHCE-VERIFICAR): URL base del API (variable APIMurl de la colección
# Postman v1.5). La entrega MinSalud. Debe ser https.
IHCE_BASE_URL=

# Endpoint de token de Microsoft Entra ID. Por defecto el de la colección
# Postman: https://login.microsoftonline.com/{tenant_id}/oauth2/v2.0/token
IHCE_TOKEN_URL=

# TODO(IHCE-VERIFICAR): identificador del tenant de Entra ID y scope del API
# (variables tenant_id y scope de la colección). No son secretos, pero los
# entrega MinSalud.
IHCE_TENANT_ID=
IHCE_SCOPE=

# Tiempos de espera (segundos).
IHCE_TIMEOUT_CONNECT_S=
IHCE_TIMEOUT_READ_S=

# Reintentos: intentos máximos y backoff exponencial (segundos).
IHCE_MAX_INTENTOS=
IHCE_BACKOFF_BASE_S=
IHCE_BACKOFF_TOPE_S=

# Tamaño máximo del PDF de soporte (bytes).
IHCE_ATTACHMENT_MAX_BYTES=

# D1: estilo de referencias internas: hash (#Tipo-n, por defecto) | plain.
IHCE_REFERENCE_STYLE=

# D2: el Encounter viaja como entrada del Bundle: true (por defecto) | false.
IHCE_BUNDLE_ENCOUNTER_ENTRY=

# D3: Bundle.identifier: omitir (por defecto, como Postman) | uuid.
IHCE_BUNDLE_IDENTIFIER=

# Dónde se lee el VIDA en la respuesta y su system.
IHCE_VIDA_PATH=
IHCE_VIDA_SYSTEM=

# Firma del Bundle: off (por defecto). TODO(IHCE-VERIFICAR) si se exige.
IHCE_SIGNING_MODE=

# D6: fuente del display CIE-10: sispro (por defecto) | guia.
IHCE_DISPLAY_CIE10=

# Zona horaria del consultorio (±HH:MM). Por defecto -05:00.
IHCE_ZONA_HORARIA=

# Título del Composition. Por defecto «RDA Consulta».
IHCE_TITULO_COMPOSITION=

# Cortacircuitos: fallos seguidos que lo abren y espera (segundos).
IHCE_CORTACIRCUITOS_UMBRAL=
IHCE_CORTACIRCUITOS_ESPERA_S=

# Envíos simultáneos por prestador.
IHCE_CONCURRENCIA_TENANT=

# Retención de la bitácora de intentos (días).
IHCE_RETENCION_BITACORA_DIAS=
